-- 3) Bulk Insert
BULK INSERT dbo.PCR_Staging
FROM 'D:\Downloads\ASCII 2023 CP25\pub_pcrevents_cp25_converted.csv'
WITH (
    DATAFILETYPE   = 'char',
    FORMAT         = 'CSV',      -- SQL Server 2017+ [web:147][web:148]
    FIRSTROW       = 2,          -- skip header row
    FIELDTERMINATOR = ',',       -- from the PowerShell conversion
    ROWTERMINATOR   = '\n',      -- use '\r\n' if needed
    BATCHSIZE       = 50000,     -- good starting point for 45M+ rows [web:113][web:115]
    TABLOCK,
    KEEPNULLS
);


